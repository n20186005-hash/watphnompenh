---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { nearbyPlaces, nearbySlugs, type NearbySlug } from '../../../data/nearby-places';
import { siteConfig } from '../../../config';

export function getStaticPaths() {
  return ['en', 'zh', 'km'].flatMap(lang => nearbySlugs.map(place => ({ params: { lang, place } })));
}
const lang = (Astro.params.lang ?? 'en') as 'en' | 'zh' | 'km';
const slug = Astro.params.place as NearbySlug;
const place = nearbyPlaces[slug];
const c = place.content[lang];
const copy = {
  en: { home: 'Wat Phnom', nearby: 'Nearby attractions', intro: 'Explore this place', tips: 'Visitor tips', features: 'Highlights', about: 'About and management', facts: 'Essential information', address: 'Address', hours: 'Opening hours', hoursValue: 'Check the current venue notice before your visit', fee: 'Tickets and admission', feeValue: 'Check current prices and conditions at the venue', transit: 'Getting there', story: 'History', architecture: 'Architecture', culture: 'Culture and experience', route: 'Suggested walking route', photos: 'Photography viewpoints', stay: 'Where to stay', food: 'Food and refreshments', reviews: 'Visitor reviews', reviewsText: 'For current ratings and review counts, consult this attraction’s own Google Maps listing.', map: 'Open this attraction in Google Maps', sources: 'Sources and photo reference', updated: 'Fact review: 16 November 2026', next: 'Continue exploring', visit: 'Before setting out, allow extra time for road crossings, weather and local opening arrangements.' },
  zh: { home: '塔山寺', nearby: '周边景点', intro: '探索景点', tips: '参观须知', features: '特色看点', about: '关于景点与管理主体', facts: '基本资料', address: '具体地址', hours: '开放时间', hoursValue: '请在参观当日查看景点公告', fee: '门票价格', feeValue: '按现场规定核实门票与入场条件', transit: '交通方式', story: '历史背景', architecture: '建筑特色', culture: '文化与体验', route: '编号游览路线', photos: '拍照机位', stay: '住宿建议', food: '美食与休息', reviews: '游客评价', reviewsText: '最新评分与评价数量请查看此景点自己的 Google Maps 页面。', map: '打开该景点 Google Maps 定位', sources: '资料来源及配图出处', updated: '资料查阅：2026年11月16日', next: '继续探索', visit: '出行时请预留过街、天气变化及现场开放安排的机动时间。' },
  km: { home: 'វត្តភ្នំ', nearby: 'កន្លែងទស្សនាជិតខាង', intro: 'ស្វែងយល់ពីទីតាំង', tips: 'ការណែនាំអ្នកទស្សនា', features: 'ចំណុចពិសេស', about: 'អំពីទីតាំង និងការគ្រប់គ្រង', facts: 'ព័ត៌មានមូលដ្ឋាន', address: 'អាសយដ្ឋាន', hours: 'ម៉ោងបើក', hoursValue: 'សូមពិនិត្យសេចក្តីជូនដំណឹងនៅថ្ងៃទស្សនា', fee: 'សំបុត្រ និងថ្លៃចូល', feeValue: 'សូមពិនិត្យតម្លៃនិងលក្ខខណ្ឌនៅទីតាំង', transit: 'ការធ្វើដំណើរ', story: 'ប្រវត្តិសាស្ត្រ', architecture: 'ស្ថាបត្យកម្ម', culture: 'វប្បធម៌ និងបទពិសោធន៍', route: 'ផ្លូវដើរទស្សនាណែនាំ', photos: 'កន្លែងថតរូប', stay: 'កន្លែងស្នាក់នៅ', food: 'អាហារ និងការសម្រាក', reviews: 'មតិអ្នកទស្សនា', reviewsText: 'សម្រាប់ពិន្ទុ និងចំនួនមតិថ្មីៗ សូមមើល Google Maps របស់ទីតាំងនេះ។', map: 'បើកទីតាំងនេះនៅ Google Maps', sources: 'ប្រភពព័ត៌មាន និងរូបភាព', updated: 'ពិនិត្យប្រភព៖ ១៦ វិច្ឆិកា ២០២៦', next: 'បន្តដំណើរ', visit: 'សូមទុកពេលបន្ថែមសម្រាប់ការឆ្លងផ្លូវ អាកាសធាតុ និងការបើកទ្វារនៅទីតាំង។' },
}[lang];
const canonical = `${siteConfig.baseUrl}/${lang}/nearby/${slug}/`;
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faq.map(x => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) };
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: copy.home, item: `${siteConfig.baseUrl}/${lang}/` }, { '@type': 'ListItem', position: 2, name: copy.nearby, item: `${siteConfig.baseUrl}/${lang}/nearby/` }, { '@type': 'ListItem', position: 3, name: c.name, item: canonical }] };
---
<BaseLayout title={`${c.name} | ${copy.nearby}`} description={`${c.tagline}. ${c.intro}`} path={`nearby/${slug}`} pageType="legal" image={`${siteConfig.baseUrl}${place.image}`}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <article class="nearby-article container">
    <nav class="breadcrumbs"><a href={`/${lang}/`}>{copy.home}</a> / <a href={`/${lang}/nearby/`}>{copy.nearby}</a> / {c.name}</nav>
    <header class="place-hero"><div><p class="eyebrow">{copy.nearby}</p><h1>{c.name}</h1><p class="tagline">{c.tagline}</p><p>{c.intro}</p><div class="hero-meta"><span>{place.address}</span><span>{copy.hoursValue}</span></div><a class="map-button" target="_blank" rel="noopener noreferrer" href={place.map}>{copy.map} ↗</a></div><img src={place.image} width="960" height="650" loading="eager" alt={c.name} /></header>
    <section class="about-panel"><p class="eyebrow">{copy.about}</p><h2>{c.name}</h2><p>{c.management}</p></section>
    <section class="nearby-section"><h2>{copy.intro}</h2><p>{c.intro}</p><h3>{copy.tips}</h3><p>{copy.visit}</p></section>
    <section class="nearby-section"><h2>{copy.features}</h2><ul>{c.highlights.map(x => <li>{x}</li>)}</ul></section>
    <section class="nearby-section"><h2>{copy.facts}</h2><dl class="details"><div><dt>{copy.address}</dt><dd>{place.address}</dd></div><div><dt>{copy.hours}</dt><dd>{copy.hoursValue}</dd></div><div><dt>{copy.fee}</dt><dd>{copy.feeValue}</dd></div><div><dt>Google Maps</dt><dd><a href={place.map} target="_blank" rel="noopener noreferrer">{copy.map} ↗</a></dd></div></dl></section>
    <section class="nearby-section"><h2>{copy.transit}</h2><p>{c.travel}</p><p><a href={`/${lang}/how-to-get-there/`}>{copy.home} — {copy.transit} →</a></p></section>
    <section class="nearby-section"><h2>{copy.story}</h2><p>{c.history}</p><h2>{copy.architecture}</h2><p>{c.architecture}</p><h2>{copy.culture}</h2><p>{c.culture}</p></section>
    <section class="nearby-section"><h2>{copy.route}</h2><ol>{c.route.map(x => <li>{x}</li>)}</ol></section>
    <section class="nearby-section"><h2>{copy.tips}</h2><p>{copy.visit}</p><h2>{copy.photos}</h2><p>{c.photography}</p></section>
    <section class="nearby-section"><h2>{copy.stay}</h2><p>{c.stay}</p><h2>{copy.food}</h2><p>{c.food}</p></section>
    <section class="nearby-section"><h2>{copy.reviews}</h2><p>{copy.reviewsText}</p><a href={place.map} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></section>
    <section class="nearby-section"><h2>FAQ</h2>{c.faq.map(x => <div class="answer"><h3>{x.q}</h3><p>{x.a}</p></div>)}</section>
    <section class="nearby-section"><h2>{copy.sources}</h2><p>{copy.updated}</p><p><a href={place.source} target="_blank" rel="noopener noreferrer">{copy.sources} ↗</a> · <a href={place.photoSource} target="_blank" rel="noopener noreferrer">Photo source ↗</a></p></section>
    <section class="nearby-section"><h2>{copy.next}</h2><div class="related">{nearbySlugs.filter(s => s !== slug).map(s => <a href={`/${lang}/nearby/${s}/`}>{nearbyPlaces[s].content[lang].name} →</a>)}<a href={`/${lang}/`}>{copy.home} →</a></div></section>
  </article>
</BaseLayout>
<style>
  .nearby-article{padding-top:2rem;padding-bottom:5rem}.breadcrumbs{color:var(--text-muted);margin:0 0 2rem;font-size:.9rem}.breadcrumbs a,.nearby-section a{color:var(--accent-strong)}.place-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:2.5rem;margin-bottom:2.5rem}.place-hero h1{font-size:clamp(2.2rem,4vw,3.6rem);line-height:1.14}.place-hero p{line-height:1.8}.place-hero .tagline{font-size:1.25rem;color:var(--accent-strong)}.place-hero img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:var(--radius)}.hero-meta{display:grid;gap:.5rem;color:var(--text-muted);font-size:.9rem;margin:1rem 0}.map-button{display:inline-block;padding:.8rem 1.2rem;background:var(--accent);color:#17130b;font-weight:700;border-radius:8px}.about-panel{padding:1.8rem 2rem;background:var(--surface-accent);border-radius:var(--radius);margin-bottom:2rem}.about-panel p,.nearby-section p,.nearby-section li{line-height:1.85}.nearby-section{margin:2.3rem 0;max-width:900px}.nearby-section h2{font-size:1.6rem;margin:1.3rem 0 .8rem}.nearby-section h3{font-size:1.15rem;margin:1.1rem 0 .6rem}.nearby-section ul,.nearby-section ol{padding-left:1.7rem}.nearby-section li{padding-left:.3rem;margin:.4rem 0}.details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.details div{padding:1rem;border:1px solid var(--border);border-radius:10px}.details dt{font-weight:700;margin-bottom:.5rem}.details dd{margin:0;overflow-wrap:anywhere;line-height:1.6}.related{display:flex;flex-wrap:wrap;gap:1rem}.related a{padding:1rem;border:1px solid var(--border);border-radius:10px}.answer{margin-bottom:1.5rem}@media(max-width:750px){.place-hero,.details{grid-template-columns:1fr}.place-hero{gap:1rem}.nearby-article{padding-top:1rem}}
</style>
