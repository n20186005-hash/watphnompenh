---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { onwardMaps, topicBySlug, topics } from '../../../data/topic-guides';
import { mapsUrl } from '../../../config';

export function getStaticPaths() {
  return ['en', 'zh', 'km'].flatMap(lang => topics.map(topic => ({ params: { lang, topic: topic.slug } })));
}
const lang = Astro.params.lang as 'en'|'zh'|'km';
const slug = Astro.params.topic!;
const topic = topicBySlug[slug];
const copy = topic[lang];
const photoUrl = `/gallery/${typeof topic.photo === 'number' ? `wat-phnom-daun-penh-${topic.photo}.jpg` : topic.photo}`;
const onward = onwardMaps[slug];
const onwardUrl = onward ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(onward.query)}` : null;
const words = {
  en: { back:'All specialist guides', home:'Wat Phnom', hero:'Focused travel guide', about:'About Wat Phnom and its care', aboutText:'Wat Phnom is an active Buddhist temple and a historic public landmark. The sanctuary remains a place of worship; its hill and surrounding roads are also used by local residents. Follow the instructions of those responsible for each space, and respect people conducting prayers.', fact:'At a glance', location:'Location', locationValue:'Wat Phnom Road, Daun Penh, Phnom Penh 12000, Cambodia', visits:'Visiting hours and admission', visitsValue:'Check the entrance notice on the day of your visit; published schedules and visitor-category fees may change.', visit:'What to notice', plan:'How to explore this topic', steps:'Suggested sequence', tip:'Practical advice', faq:'Frequently asked question', map:'See Wat Phnom on Google Maps', source:'Source and verification', nearby:'Explore nearby landmarks', related:'More Wat Phnom guides', photo:'Photograph of Wat Phnom temple and hill', review:'Visitor reviews', reviewText:'For the current rating and full original reviews, refer to the Google Maps place listing. Review figures change over time.', updated:'Content checked 16 November 2026', photoStart:'Wat Phnom starting-point photo; the onward destination is separate.', route:['Start at a safe approach to the hill and locate the public stairs.', 'Explore the feature described in this guide without interrupting worship.', 'Compare it with the main sanctuary, Lady Penh shrine and memorial stupa.', 'Return to the base and open a separate map destination for any onward stop.'] },
  zh: { back:'全部专题指南',home:'塔山寺',hero:'主题深度指南',about:'关于塔山寺及其维护',aboutText:'塔山寺是仍在进行佛教礼拜的寺院，也是金边历史公共地标。主殿属于宗教空间，山丘和周边道路也服务当地居民；请遵循各区域现场管理指引，尊重正在祈祷的人。',fact:'基本参观信息',location:'具体位置',locationValue:'Wat Phnom Road, Daun Penh, Phnom Penh 12000, Cambodia',visits:'开放时间与门票',visitsValue:'以到访当日入口公告为准；公开时段与不同游客类别收费可能变化。',visit:'重点观察',plan:'专题参观建议',steps:'推荐行走顺序',tip:'实用提醒',faq:'常见问题',map:'在谷歌地图查看塔山寺',source:'资料来源与核实',nearby:'周边景点',related:'其他塔山寺指南',photo:'金边塔山寺及山丘实景照片',review:'游客评价',reviewText:'最新评分、评论总数及原始评论请查看谷歌地图独立地点页面；数据会随时间变化。',updated:'资料核查：2026年11月16日',photoStart:'照片展示塔山寺路线起点，后续景点为独立目的地。',route:['从安全入口抵达山脚，先找到开放的公共台阶。','按本篇主题观察相关建筑或游览细节，不打扰礼佛。','比较主殿、奔夫人祠及后方纪念佛塔的不同功能。','下山后如要前往其他地点，请打开各自独立地图定位。'] },
  km: { back:'មគ្គុទ្ទេសក៍ប្រធានបទទាំងអស់',home:'វត្តភ្នំ',hero:'មគ្គុទ្ទេសក៍ជាក់លាក់',about:'អំពីវត្តភ្នំ និងការថែទាំ',aboutText:'វត្តភ្នំជាវត្តព្រះពុទ្ធសាសនាដែលនៅមានការបូជា និងជាទីសម្គាល់សាធារណៈប្រវត្តិសាស្ត្រ។ ព្រះវិហារជាកន្លែងសក្ការៈ រីឯភ្នំនិងផ្លូវជុំវិញក៏មានអ្នកស្រុកប្រើប្រាស់។ សូមធ្វើតាមការណែនាំនិងគោរពអ្នកបួងសួង។',fact:'ព័ត៌មានសម្រាប់ទស្សនា',location:'ទីតាំង',locationValue:'Wat Phnom Road, Daun Penh, Phnom Penh 12000, Cambodia',visits:'ម៉ោងបើក និងតម្លៃចូល',visitsValue:'សូមពិនិត្យសេចក្ដីជូនដំណឹងនៅច្រកចូលក្នុងថ្ងៃទស្សនា ព្រោះម៉ោងនិងតម្លៃតាមប្រភេទភ្ញៀវអាចប្រែប្រួល។',visit:'ចំណុចគួរសង្កេត',plan:'របៀបទស្សនាប្រធានបទនេះ',steps:'លំដាប់ដំណើរណែនាំ',tip:'ការណែនាំជាក់ស្ដែង',faq:'សំណួរញឹកញាប់',map:'មើលវត្តភ្នំនៅ Google Maps',source:'ប្រភព និងការផ្ទៀងផ្ទាត់',nearby:'ទីតាំងក្បែរៗ',related:'មគ្គុទ្ទេសក៍វត្តភ្នំផ្សេងៗ',photo:'រូបថតវត្តភ្នំ និងភ្នំដូនពេញ',review:'មតិអ្នកទស្សនា',reviewText:'សូមមើលពិន្ទុ ចំនួនមតិ និងមតិដើមថ្មីៗនៅទីតាំង Google Maps។ ទិន្នន័យអាចផ្លាស់ប្ដូរ។',updated:'បានពិនិត្យប្រភពថ្ងៃទី១៦ វិច្ឆិកា ២០២៦',photoStart:'រូបថតបង្ហាញចំណុចចាប់ផ្ដើមនៅវត្តភ្នំ។ ទីតាំងបន្ទាប់ជាកន្លែងដាច់ដោយឡែក។',route:['ចាប់ពីច្រកសុវត្ថិភាពនៅជើងភ្នំ និងរកជណ្តើរសាធារណៈ។','សង្កេតចំណុចតាមប្រធានបទនេះដោយមិនរំខានការបូជា។','ប្រៀបធៀបព្រះវិហារ កន្លែងដូនពេញ និងចេតិយរំលឹកខាងក្រោយ។','ចុះភ្នំ រួចប្រើផែនទីដាច់ដោយឡែកសម្រាប់ទីតាំងបន្ទាប់។'] },
}[lang];
const nearby = [{ slug:'central-post-office',en:'Central Post Office',zh:'金边中央邮局',km:'ប្រៃសណីយ៍កណ្ដាល' },{slug:'central-market',en:'Central Market',zh:'中央市场',km:'ផ្សារធំថ្មី'},{slug:'national-museum',en:'National Museum',zh:'国家博物馆',km:'សារមន្ទីរជាតិ'}];
const suggestions = topics.filter(t => t.group === topic.group && t.slug !== slug).slice(0,4);
const faq = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:copy.question,acceptedAnswer:{'@type':'Answer',text:copy.answer}}]};
const breadcrumbs = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:words.home,item:`https://watphnompenh.com/${lang}/`},{'@type':'ListItem',position:2,name:words.back,item:`https://watphnompenh.com/${lang}/guides/`},{'@type':'ListItem',position:3,name:copy.title,item:`https://watphnompenh.com/${lang}/guides/${slug}/`}]};
---
<BaseLayout title={copy.title} description={`${copy.intro} ${copy.advice}`} path={`guides/${slug}`} pageType="legal">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faq)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <article class="topic container">
    <nav class="crumb" aria-label="Breadcrumb"><a href={`/${lang}/`}>{words.home}</a> / <a href={`/${lang}/guides/`}>{words.back}</a></nav>
    <header class="hero"><div><p class="eyebrow">{words.hero}</p><h1>{copy.title}</h1><p class="lead">{copy.intro}</p><a class="action" href={mapsUrl} target="_blank" rel="noopener noreferrer">{words.map} ↗</a></div><figure><img src={photoUrl} alt={typeof topic.photo === 'string' ? copy.title : words.photo} width="840" height="560" loading="eager" />{topic.group === 'routes' && typeof topic.photo === 'number' && <figcaption>{words.photoStart}</figcaption>}</figure></header>
    <section class="about"><h2>{words.about}</h2><p>{words.aboutText}</p></section>
    <section class="facts"><h2>{words.fact}</h2><dl><div><dt>{words.location}</dt><dd>{words.locationValue} · HWGF+F6</dd></div><div><dt>{words.visits}</dt><dd>{words.visitsValue}</dd></div></dl></section>
    <div class="columns"><div>
      <section><h2>{words.visit}</h2><p>{copy.detail}</p></section>
      <section><h2>{words.plan}</h2><p>{copy.advice}</p></section>
      <section><h2>{words.steps}</h2><ol>{words.route.map(s=><li>{s}</li>)}</ol></section>
      <section><h2>{words.faq}</h2><h3>{copy.question}</h3><p>{copy.answer}</p></section>
      <section><h2>{words.review}</h2><p>{words.reviewText}</p><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></section>
      {onwardUrl && <section><h2>{words.nearby}: {onward.name}</h2><p>{copy.advice}</p><a href={onwardUrl} target="_blank" rel="noopener noreferrer">Google Maps: {onward.name} ↗</a></section>}
      <section><h2>{words.nearby}</h2><div class="link-list">{nearby.map(p=><a href={`/${lang}/nearby/${p.slug}/`}>{p[lang]} →</a>)}</div></section>
    </div><aside><h2>{words.related}</h2>{suggestions.map(t=><a href={`/${lang}/guides/${t.slug}/`}>{t[lang].title} →</a>)}<a href={`/${lang}/guides/`}>{words.back} →</a><h2>{words.source}</h2><p>{words.updated}</p><a href={topic.source} rel="noopener noreferrer" target="_blank">{topic.source.includes('mcfa.gov') ? 'Ministry of Culture and Fine Arts' : 'Tourism Cambodia'} ↗</a><a href={mapsUrl} rel="noopener noreferrer" target="_blank">Google Maps ↗</a></aside></div>
  </article>
</BaseLayout>
<style>
.topic{padding:3rem 0 5rem}.crumb{margin-bottom:2rem;font-size:.9rem;color:var(--text-muted)}.crumb a,aside a,.link-list a{color:var(--accent-strong)}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:2.5rem;align-items:center;margin-bottom:3rem}.hero h1{font-size:clamp(2rem,4vw,3.3rem);line-height:1.2;margin:.5rem 0 1.5rem}.lead{font-size:1.13rem;line-height:1.85}.hero figure{margin:0}.hero img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:var(--radius)}.hero figcaption{font-size:.83rem;line-height:1.5;color:var(--text-muted);margin-top:.5rem}.action{display:inline-block;background:var(--accent);color:#17130b;border-radius:9px;padding:.8rem 1rem;margin-top:1rem;font-weight:700}.about{background:var(--surface-accent);border-radius:var(--radius);padding:1.5rem 2rem;margin-bottom:2.5rem}.topic h2{font-size:1.55rem;margin:0 0 1rem}.topic h3{font-size:1.1rem;margin-bottom:.7rem}.topic p,.topic li{line-height:1.9}.facts{margin-bottom:3rem}.facts dl{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.facts dl div{border:1px solid var(--border);border-radius:10px;padding:1rem}.facts dt{font-weight:700}.facts dd{margin:.5rem 0 0;line-height:1.6}.columns{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:3rem}.columns section{margin-bottom:2.5rem}.columns ol{padding-left:1.6rem}.columns li{margin-bottom:.9rem}.columns aside{align-self:start;padding:1.5rem;background:var(--surface-accent);border-radius:var(--radius);display:grid;gap:1rem}.columns aside h2{font-size:1.15rem;margin:1rem 0 0}.columns aside a{overflow-wrap:anywhere;line-height:1.5}.columns aside p{color:var(--text-muted);font-size:.88rem}.link-list{display:flex;flex-wrap:wrap;gap:1.5rem}@media(max-width:800px){.hero,.columns,.facts dl{grid-template-columns:1fr}.topic{padding-top:1.5rem}.hero{gap:1.5rem}.columns aside{order:-1}}
</style>
