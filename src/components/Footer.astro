---
interface Props {
  lang: string;
  messages: any;
  t: (k: string) => string;
}
const { lang, messages: m } = Astro.props;
const f = m.footer;
const rights = {
  zh: '版權所有',
  en: 'All rights reserved',
  km: 'រក្សាសិទ្ធិគ្រប់យ៉ាង',
}[lang] ?? 'All rights reserved';
const independence = {
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联',
  en: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  km: 'គេហទំព័រនេះជាគម្រោងព័ត៌មានទេសចរណ៍ឯករាជ្យ។ យើងមិនមានទំនាក់ទំនងជាមួយស្ថាប័នរដ្ឋាភិបាល ឬអង្គការផ្លូវការណាមួយឡើយ។',
}[lang] ?? 'This website is an independent travel information project.';
---

<footer class="site-footer">
  <div class="container footer-bottom">
    <p>© 2026 {f.siteName} · {rights}</p>
    <p>{independence}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-accent); border-top: 1px solid var(--border); margin-top: 40px; padding-block: 24px; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px 28px; }
  .footer-bottom p { margin: 0; color: var(--text-muted); font-size: 0.82rem; line-height: 1.7; }
</style>
