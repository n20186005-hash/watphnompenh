---
interface Props {
  lang: string;
  messages: any;
}
const { messages: m } = Astro.props;
const s = m.itineraries;
---

<section id="routes" class="section-padding">
  <div class="container">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 class="section-title">{s.title}</h2>
    <p class="section-lead">{s.subtitle}</p>

    <div class="plan-grid">
      {[s.half, s.full].map((plan: any, idx: number) => (
        <article class={`plan-card card card-pad plan-${idx}`}>
          <header class="plan-head">
            <span class="plan-badge">{plan.badge}</span>
            <h3>{plan.title}</h3>
            <p class="plan-meta">{plan.duration} · {plan.intensity}</p>
            <p class="plan-summary">{plan.summary}</p>
          </header>

          <ol class="plan-steps">
            {plan.steps.map((step: any) => (
              <li>
                <span class="step-time">{step.time}</span>
                <div class="step-body">
                  <strong>{step.title}</strong>
                  <p>{step.text}</p>
                </div>
              </li>
            ))}
          </ol>

          <p class="plan-tip">{plan.tip}</p>
        </article>
      ))}
    </div>

    <p class="plan-note">{s.note}</p>
  </div>
</section>

<style>
  .plan-grid { margin-top: 30px; display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); }
  .plan-card { display: flex; flex-direction: column; }
  .plan-head h3 { margin: 10px 0 6px; font-size: 1.3rem; }
  .plan-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .plan-1 .plan-badge { background: #e0ebf5; color: #2f5d80; }
  .plan-meta { margin: 0; font-size: 0.84rem; color: var(--text-muted); font-weight: 600; }
  .plan-summary { margin: 10px 0 0; color: var(--text); line-height: 1.75; }
  .plan-steps { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 16px; }
  .plan-steps li { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 14px; }
  .step-time {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-strong);
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  .step-body strong { display: block; color: var(--heading); font-size: 0.98rem; }
  .step-body p { margin: 4px 0 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; }
  .plan-tip {
    margin: 22px 0 0;
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    background: var(--surface-accent);
    border-radius: 0 var(--radius-sm, 10px) var(--radius-sm, 10px) 0;
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .plan-note { margin: 18px 0 0; font-size: 0.82rem; color: var(--text-muted); }
  @media (max-width: 520px) {
    .plan-steps li { grid-template-columns: 64px minmax(0, 1fr); gap: 10px; }
  }
</style>
