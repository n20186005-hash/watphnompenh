---
interface Props {
  lang: string;
  messages: any;
}
const { messages: m } = Astro.props;
const s = m.audience;

const icons: Record<string, string> = {
  family: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2.2"/><path d="M3.5 20c0-3 2.5-5.2 5.5-5.2s5.5 2.2 5.5 5.2"/><path d="M14.5 20c0-2.2 1.4-3.8 3.4-3.8 1.9 0 3.1 1.4 3.1 3.8"/>',
  photo: '<path d="M3 8.5A2 2 0 0 1 5 6.5h1.6l1.2-2h8.4l1.2 2H19a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="3.6"/>',
  accessible: '<circle cx="12" cy="4.6" r="1.9"/><path d="M12 7.6v5h4.4l2.6 6.4"/><path d="M12 12.6H7.4l-1 4.2"/><path d="M9 21.4a4.6 4.6 0 1 1 6.4-4.3"/>',
};
---

<section id="audience" class="section-padding audience-section">
  <div class="container">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 class="section-title">{s.title}</h2>
    <p class="section-lead">{s.subtitle}</p>

    <div class="au-grid">
      {s.items.map((it: any) => (
        <article class="au-card card card-pad">
          <span class="au-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.id] ?? icons.family}></svg>
          </span>
          <h3>{it.title}</h3>
          <p class="au-meta">{it.meta}</p>
          <p class="au-summary">{it.summary}</p>
          <ul class="au-points">
            {it.points.map((p: string) => <li>{p}</li>)}
          </ul>
          <p class="au-tip">{it.tip}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .audience-section { background: var(--surface-accent); }
  .au-grid { margin-top: 30px; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .au-card { display: flex; flex-direction: column; }
  .au-ico {
    width: 46px; height: 46px;
    border-radius: 14px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    display: grid; place-items: center;
  }
  .au-ico svg { width: 24px; height: 24px; }
  .au-card h3 { margin: 14px 0 4px; font-size: 1.16rem; }
  .au-meta { margin: 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; color: var(--accent-strong); text-transform: uppercase; }
  .au-summary { margin: 12px 0 0; color: var(--text); line-height: 1.75; font-size: 0.94rem; }
  .au-points { margin: 16px 0 0; padding-left: 0; list-style: none; display: grid; gap: 8px; }
  .au-points li { position: relative; padding-left: 20px; font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); }
  .au-points li::before {
    content: '';
    position: absolute;
    left: 2px; top: 0.62em;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .au-tip { margin: 18px 0 0; padding-top: 14px; border-top: 1px dashed var(--border); font-size: 0.86rem; color: var(--text-muted); line-height: 1.7; }
</style>
