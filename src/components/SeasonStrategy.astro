---
interface Props {
  lang: string;
  messages: any;
}
const { messages: m } = Astro.props;
const s = m.season;
const cols = s.columns;
---

<section id="season" class="section-padding season-section">
  <div class="container">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 class="section-title">{s.title}</h2>
    <p class="section-lead">{s.subtitle}</p>

    {s.intro && <p class="season-intro">{s.intro}</p>}

    <div class="season-scroll" tabindex="0" role="region" aria-label={s.title}>
      <table class="season-table">
        <thead>
          <tr>
            <th scope="col">{cols.season}</th>
            <th scope="col">{cols.weather}</th>
            <th scope="col">{cols.water}</th>
            <th scope="col">{cols.wildlife}</th>
            <th scope="col">{cols.strategy}</th>
          </tr>
        </thead>
        <tbody>
          {s.rows.map((r: any, i: number) => (
            <tr class={`season-row season-row-${i}`}>
              <th scope="row">
                <span class="season-name">{r.name}</span>
                <span class="season-period">{r.period}</span>
                <span class="season-tag">{r.tag}</span>
              </th>
              <td data-label={cols.weather}>{r.weather}</td>
              <td data-label={cols.water}>{r.water}</td>
              <td data-label={cols.wildlife}>{r.wildlife}</td>
              <td data-label={cols.strategy}>{r.strategy}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="season-note">{s.note}</p>
  </div>
</section>

<style>
  .season-section { background: var(--surface); }
  .season-intro { margin: 18px 0 0; max-width: 860px; color: var(--text); line-height: 1.85; }
  .season-scroll { margin-top: 26px; overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-md, 14px); background: var(--surface); }
  .season-table { width: 100%; min-width: 980px; border-collapse: collapse; font-size: 0.9rem; }
  .season-table thead th {
    text-align: left;
    padding: 14px 16px;
    background: var(--surface-accent);
    color: var(--heading);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
  }
  .season-table tbody th,
  .season-table tbody td {
    padding: 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
    line-height: 1.75;
    color: var(--text);
  }
  .season-table tbody tr:last-child th,
  .season-table tbody tr:last-child td { border-bottom: 0; }
  .season-table tbody th { width: 158px; background: color-mix(in srgb, var(--surface-accent) 45%, transparent); }
  .season-name { display: block; font-weight: 700; color: var(--heading); font-size: 1rem; }
  .season-period { display: block; margin-top: 4px; font-size: 0.8rem; color: var(--text-muted); font-weight: 500; }
  .season-tag {
    display: inline-block;
    margin-top: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .season-row-0 .season-tag { background: #e3f0e6; color: #2f6b45; }
  .season-row-1 .season-tag { background: #fbe8dc; color: #a2532a; }
  .season-row-2 .season-tag { background: #e0ebf5; color: #2f5d80; }
  .season-note { margin: 18px 0 0; font-size: 0.82rem; line-height: 1.7; color: var(--text-muted); }

  @media (max-width: 860px) {
    .season-scroll { border: 0; overflow: visible; }
    .season-table { min-width: 0; }
    .season-table thead { display: none; }
    .season-table tbody, .season-table tr, .season-table th, .season-table td { display: block; width: auto; }
    .season-row {
      border: 1px solid var(--border);
      border-radius: var(--radius-md, 14px);
      margin-bottom: 14px;
      overflow: hidden;
      background: var(--surface);
    }
    .season-table tbody th, .season-table tbody td { padding: 14px 16px; }
    .season-table tbody td { border-bottom: 0; border-top: 1px dashed var(--border); }
    .season-table tbody td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 4px;
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--accent-strong);
      font-weight: 700;
    }
  }
</style>
