---
import '../styles/global.css';
import { getI18n, buildAlternates, htmlLangAttr } from '../i18n/ui';
import siteConfig, {
  mapsUrl,
  GA_MEASUREMENT_ID,
  ATTRACTION_FULL_NAME,
  ATTRACTION_SHORT_NAME,
  CITY_NAME,
  STATE_PROVINCE,
  COUNTRY_NAME,
  COUNTRY_CODE_2LETTER,
  POSTAL_CODE,
  LATITUDE,
  LONGITUDE,
  GOVT_TOURISM_URL,
} from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const props = Astro.props as {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  type?: string;
  lang?: string;
  canonical?: string;
  pageType?: 'attraction' | 'legal';
};
const pageType = props.pageType ?? 'attraction';

const { lang, messages, t } = getI18n(Astro.url);
const activeLang = props.lang ?? lang;
const alt = buildAlternates(props.path ?? '');

const SITE = siteConfig.baseUrl;
// 规范 URL：一律以尾斜杠结尾（如 https://watphnompenh.com/en/），与实际部署路径及 hreflang 完全一致
const rawPath = props.path ?? '';
const normPath = rawPath === '' || rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const pageUrl = props.canonical ?? `${SITE}/${activeLang}${normPath || '/'}`;
const title = props.title ?? messages.meta.title;
const description = props.description ?? messages.meta.description;
const image = props.image ?? `${SITE}/gallery/wat-phnom-daun-penh-1.jpg`;
const imageAlt = `${ATTRACTION_FULL_NAME} in ${CITY_NAME}`;
const localeMap: Record<string, string> = { km: 'km_KH', en: 'en_US', zh: 'zh_CN' };

/* ============================================================
 * 1. 结构化数据 (Schema.org / JSON-LD) — TouristAttraction 实体
 *    说明：评分/评价数仅做页面展示，按规范不写入 JSON-LD。
 * ============================================================ */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${SITE}/#attraction`,
  name: ATTRACTION_FULL_NAME,
  alternateName: [
    ATTRACTION_SHORT_NAME,
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`,
    attractionNameByLang(activeLang),
  ].filter(Boolean),
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: SITE,
  image: [
    `${SITE}/gallery/wat-phnom-daun-penh-1.jpg`,
    `${SITE}/gallery/wat-phnom-daun-penh-2.jpg`,
    `${SITE}/gallery/wat-phnom-daun-penh-3.jpg`,
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  touristType: 'Cultural tourism, Religious tourism, Photography',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Wat Phnom Road',
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: LATITUDE,
    longitude: LONGITUDE,
  },
  hasMap: mapsUrl,
  sameAs: [mapsUrl, GOVT_TOURISM_URL],
  openingHours: 'Mo-Su 07:00-19:00',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '07:00',
      closes: '19:00',
    },
  ],
  isPartOf: {
    '@type': 'TouristDestination',
    name: CITY_NAME,
    address: { '@type': 'PostalAddress', addressLocality: CITY_NAME, addressCountry: COUNTRY_CODE_2LETTER },
  },
};

function attractionNameByLang(l: string): string | null {
  const names: Record<string, string> = {
    km: 'វត្តភ្នំដូនពេញ',
    en: ATTRACTION_FULL_NAME,
    zh: '塔山寺',
  };
  return names[l] ?? null;
}

/* 2. 面包屑（实体归属层级）：景点 → 城市 → 省/直辖市 → 国家 */
const geo = messages.geo ?? { attraction: ATTRACTION_FULL_NAME, city: CITY_NAME, region: STATE_PROVINCE, country: COUNTRY_NAME };
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: geo.attraction, item: pageUrl },
    { '@type': 'ListItem', position: 2, name: geo.city, item: `${SITE}/${activeLang}#map` },
    { '@type': 'ListItem', position: 3, name: geo.region },
    { '@type': 'ListItem', position: 4, name: geo.country },
  ],
};

/* 3. FAQ 结构化数据（抢占 Featured Snippet / AI 概览卡片） */
const faqItems = (messages.faq?.items ?? []) as { q: string; a: string }[];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---
<!doctype html>
<html lang={htmlLangAttr(activeLang)} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) — GA4 -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', GA_MEASUREMENT_ID);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#b8862c" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Wat Phnom" />
    <meta name="mobile-web-app-capable" content="yes" />

    <meta property="og:type" content={props.type ?? 'website'} />
    <meta property="og:site_name" content={ATTRACTION_FULL_NAME} />
    <meta property="og:locale" content={localeMap[activeLang] ?? 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {Object.entries(alt).map(([k, v]) => (
      <link rel="alternate" hreflang={k === 'xDefault' ? 'x-default' : k} href={v} />
    ))}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    {pageType === 'attraction' && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
    )}
    {pageType === 'attraction' && faqItems.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
    )}

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved) document.documentElement.setAttribute('data-theme', saved);
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header lang={activeLang} messages={messages} t={t} />
    <main>
      <slot />
    </main>
    <Footer lang={activeLang} messages={messages} t={t} />

    <script is:inline>
      // Theme toggle
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var root = document.documentElement;
          var cur = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          var next = cur === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      });
      // Mobile menu
      var mb = document.querySelector('[data-menu-btn]');
      var mn = document.querySelector('[data-menu]');
      if (mb && mn) {
        mb.addEventListener('click', function () { mn.classList.toggle('open'); });
        mn.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { mn.classList.remove('open'); }); });
      }
      // FAQ accordion
      document.querySelectorAll('.faq-item').forEach(function (item) {
        var q = item.querySelector('.faq-q');
        if (!q) return;
        q.addEventListener('click', function () {
          var open = item.getAttribute('data-open') === 'true';
          item.setAttribute('data-open', open ? 'false' : 'true');
          var a = item.querySelector('.faq-a');
          if (a) a.style.maxHeight = open ? '0px' : a.scrollHeight + 'px';
        });
      });
      // Reveal on scroll
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.fade-up').forEach(function (el) { io.observe(el); });
      // Lightbox
      var lb;
      // AVIF 支持检测：支持时灯箱直接加载体积更小的 AVIF 原图（同画质下约省 30% 流量）
      var supportsAvif = (function () {
        try { return document.createElement('canvas').toDataURL('image/avif').indexOf('data:image/avif') === 0; } catch (e) { return false; }
      })();
      function bestSrc(im) {
        var avif = im.getAttribute('data-avif');
        return (supportsAvif && avif) ? avif : im.getAttribute('src');
      }
      function openLightbox(startIndex) {
        var items = Array.from(document.querySelectorAll('.gallery-item img'));
        var idx = startIndex >= 0 && startIndex < items.length ? startIndex : 0;
        lb = document.createElement('div');
        lb.className = 'lightbox';
        lb.innerHTML = '<button class="lb-close" aria-label="Close">&times;</button><button class="lb-nav lb-prev" aria-label="Previous">&#8249;</button><button class="lb-nav lb-next" aria-label="Next">&#8250;</button><img src="' + bestSrc(items[idx]) + '" alt="' + (items[idx].alt || '') + '">';
        document.body.appendChild(lb);
        document.body.style.overflow = 'hidden';
        function show(i) {
          idx = (i + items.length) % items.length;
          lb.querySelector('img').src = bestSrc(items[idx]);
          lb.querySelector('img').alt = items[idx].alt || '';
        }
        lb.querySelector('.lb-close').onclick = closeLightbox;
        lb.querySelector('.lb-prev').onclick = function () { show(idx - 1); };
        lb.querySelector('.lb-next').onclick = function () { show(idx + 1); };
        lb.onclick = function (e) { if (e.target === lb) closeLightbox(); };
        document.addEventListener('keydown', function esc(e) {
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft') show(idx - 1);
          if (e.key === 'ArrowRight') show(idx + 1);
          if (e.type === 'keydown' && (e.key === 'Escape' || e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
            document.removeEventListener('keydown', esc);
          }
        });
      }
      function closeLightbox() { if (lb) { lb.remove(); lb = null; document.body.style.overflow = ''; } }
      document.querySelectorAll('.gallery-item').forEach(function (g, gi) {
        g.addEventListener('click', function () { openLightbox(gi); });
      });
      // PWA service worker registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
